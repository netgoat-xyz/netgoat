# Copy to `.env` for standalone `go run .` or container use, then
# `set -a; . ./.env; set +a`. Never commit `.env`.

# --- Control-plane snapshot stream ------------------------------------------
# Required when the agent is not running from a static config.yml alone.
API_STREAM_URL=http://127.0.0.1:8787
API_STREAM_KEY=

# --- Zero-trust challenge signing -------------------------------------------
# Maps from STREAM_DIAMOND_KEY in the workspace compose stack.
DiamondKey=
# Legacy alias for DiamondKey.
# ZERO_TRUST_KEY=

# --- Optional telemetry delivery --------------------------------------------
# TELEMETRY_ENDPOINT=http://127.0.0.1:9091/v1/events
# TELEMETRY_INGEST_KEY=

# --- Bootstrap the first local auth user on a fresh database ----------------
# Used only when the user table is empty; existing users are never overwritten.
# NETGOAT_BOOTSTRAP_USERNAME=admin
# NETGOAT_BOOTSTRAP_PASSWORD=

# --- Encrypted ACME certificate cache ---------------------------------------
# Base64-encoded 32-byte key.
# NETGOAT_ACME_CACHE_KEY=

# --- Cloudflare --------------------------------------------------------------
# Required when cloudflare.reconciliation is enabled in config.yml.
# CLOUDFLARE_API_TOKEN=
